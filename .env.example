# Optional Gemini integration. Keep credentials server-side.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLIENT_ID=
CAFEMESH_REQUIRE_GOOGLE_AUTH=false
CAFEMESH_STORAGE_BACKEND=sqlite
CAFEMESH_MODEL=gemini-2.5-flash

# Optional Google Maps adapters (server-side restricted key).
GOOGLE_MAPS_API_KEY= # server-only; prefer Secret Manager in Cloud Run

# Operational settings
CAFEMESH_DATABASE=data/cafemesh.db
CAFEMESH_DEMO_MODE=true
CAFEMESH_REQUEST_TIMEOUT_SECONDS=12
CAFEMESH_PREP_CALIBRATION_MIN_SAMPLES=3
CAFEMESH_PREP_CALIBRATION_MAX_MINUTES=180
